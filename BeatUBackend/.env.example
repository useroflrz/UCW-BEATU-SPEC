# BeatU Backend 配置文件示例
# 复制此文件为 .env 并修改相应的配置值

# 项目信息
PROJECT_NAME=BeatU Backend
VERSION=0.1.0
DEBUG=False

# 数据库配置（本地数据库示例）
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:13326932249@localhost:3306/beatu

# Redis配置（可选）
# 格式：redis://主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# API密钥（用于内部服务调用）
API_KEY=dev-key

# 服务监听配置（真机调试建议保持如下）
SERVER_PORT=9306
SERVER_HOST=0.0.0.0
